# 数据库
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/auto_grader

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# 安全
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 文件存储
STORAGE_ROOT=/workspace/ai-auto-grader/storage
MAX_UPLOAD_SIZE_MB=50

# 异步任务：大批量导入/预阅卷建议在部署了 Redis 时设为 true（Celery 分布式队列）
# 单机演示/无 Redis 环境保持 false，使用 FastAPI 后台任务内联执行
USE_CELERY=false

# 大模型配置
LLM_PROVIDER=openai
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=sk-xxx
LLM_DEFAULT_MODEL=gpt-4o
LLM_CONFIDENCE_THRESHOLD=0.7
